---
import { education, skills } from '../../data/profile';
---

<section id="about" class="about">
  <h2>About</h2>

  <div class="bio">
    <p>
      I'm a Computer Science and Applied Mathematics double major at Stony Brook University,
      graduating {education.graduation}. Right now I'm building a containerized FastAPI backend
      for ReWild Long Island and TAing Honors Data Structures.
    </p>
    <p>
      My projects sit where those two degrees meet. I write backends that take in messy financial
      data, validate it at the boundary and turn it into something you can test — from a C++
      parser for the NASDAQ ITCH 5.0 binary protocol to a retrieval-augmented evaluation harness
      for SEC filings.
    </p>
    <p>
      The part I care about is whether the numbers are right. Every project here carries a test
      suite, and every write-up says what the project does not prove. On one of them the
      interesting result was that a signal I had built pointed the wrong way, so I shelved it
      and wrote that down too.
    </p>
    <p>
      I'm looking for a Summer 2027 internship or a new-grad role. Email is the fastest way to
      reach me.
    </p>
  </div>

  <h3>Education</h3>
  <div class="edu">
    <p class="edu-head">
      <strong>{education.school}</strong>
      <span class="edu-meta">{education.location} &middot; {education.graduation}</span>
    </p>
    <ul class="edu-degrees">
      {education.degrees.map((degree) => <li>{degree}</li>)}
    </ul>
    <p class="edu-honors">{education.honors}</p>

    <details class="courses">
      <summary>Selected coursework</summary>
      <div class="course-cols">
        <div>
          <h4>Completed</h4>
          <ul>
            {education.coursework.map((course) => <li>{course}</li>)}
          </ul>
        </div>
        <div>
          <h4>Fall 2026</h4>
          <ul>
            {education.inProgress.map((course) => <li>{course}</li>)}
          </ul>
        </div>
      </div>
    </details>
  </div>

  <h3>Skills</h3>
  <div class="skills">
    {skills.map(({ group, items }) => (
      <div class="skill-group">
        <h4>{group}</h4>
        <ul class="skill-list">
          {items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .about h2 {
    font-size: 2rem;
  }

  .about h3 {
    font-size: 1.35rem;
    margin-top: 2.5rem;
  }

  .bio p {
    max-width: 68ch;
  }

  .edu {
    border-left: 2px solid var(--color-border);
    padding-left: 1.25rem;
  }

  .edu-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .edu-meta {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .edu-degrees {
    margin: 0 0 0.75rem;
    padding-left: 1.2em;
  }

  .edu-degrees li {
    color: var(--color-text-muted);
  }

  .edu-honors {
    margin: 0;
    font-size: 0.9rem;
  }

  .courses {
    margin-top: 1rem;
  }

  .courses summary {
    cursor: pointer;
    color: var(--color-accent);
    font-size: 0.9rem;
    width: fit-content;
  }

  .courses summary:hover {
    text-decoration: underline;
  }

  .course-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 2rem;
    margin-top: 1rem;
  }

  @media (min-width: 560px) {
    .course-cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  .course-cols h4 {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .course-cols ul {
    margin: 0;
    padding-left: 1.1em;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .skills {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .skill-group h4 {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
  }

  .skill-list li {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background-color: var(--color-code-bg);
    border: 1px solid transparent;
    color: var(--color-text);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
  }
</style>
