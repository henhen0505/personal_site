---
import { site, education } from '../../data/profile';
---

<section id="home" class="home">
  <p class="eyebrow">
    <span class="dot" aria-hidden="true"></span>
    Open to Summer 2027 internships and new-grad roles
  </p>

  <h1>{site.name}</h1>
  <p class="tagline">{site.tagline}</p>

  <p class="sub">
    Computer Science and Applied Mathematics at {education.school}, graduating {education.graduation}.
    Most of my work sits where a backend has to be correct and not only running.
  </p>

  <div class="actions">
    <a class="btn btn-primary" href="#projects">View projects</a>
    <a class="btn" href={site.resume}>Resume (PDF)</a>
  </div>

  <p class="links">
    <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>

  <p class="hint">
    Press <kbd data-mod-key>Ctrl</kbd><kbd>K</kbd> to jump anywhere on this page.
  </p>
</section>

<style>
  .home {
    padding-top: 2.5rem;
    padding-bottom: 1rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0.3rem 0.7rem 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-card-bg);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #16a34a;
    flex-shrink: 0;
  }

  :global([data-theme='dark']) .dot {
    background-color: #4ade80;
  }

  .home h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(2.25rem, 7vw, 3rem);
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 0 0 0.75rem;
    font-size: clamp(1.1rem, 3.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.4;
  }

  .sub {
    max-width: 60ch;
    margin: 0 0 1.75rem;
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }

  .hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: 4px;
    background-color: var(--color-code-bg);
    padding: 0.1rem 0.35rem;
    margin: 0 0.1rem;
  }

  /* The palette is keyboard-only, so hide the hint where there is no keyboard. */
  @media (hover: none) and (pointer: coarse) {
    .hint {
      display: none;
    }
  }
</style>
