---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#about', section: 'about', label: 'About' },
  { href: '/#experience', section: 'experience', label: 'Experience' },
  { href: '/#projects', section: 'projects', label: 'Projects' },
  { href: '/#resume', section: 'resume', label: 'Resume' },
];
---

<header class="nav">
  <div class="nav-inner container">
    <a href="/" class="brand">Henry Yu</a>

    <button
      id="nav-toggle"
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Toggle navigation menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav id="nav-menu" class="nav-menu" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} data-section={link.section}>{link.label}</a>
      ))}

      <div class="nav-tools">
        <button
          type="button"
          class="palette-trigger"
          data-palette-open
          aria-label="Open the jump-to search"
        >
          <span data-mod-key>Ctrl</span><span class="key-plus">K</span>
        </button>
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 150ms;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }

  .brand {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .nav-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text);
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.05rem;
  }

  .nav-menu > a {
    color: var(--color-text);
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .nav-menu > a:hover {
    color: var(--color-accent);
  }

  .nav-menu > a.active {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .palette-trigger {
    display: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background-color: var(--color-code-bg);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.32rem 0.45rem;
    cursor: pointer;
    transition: border-color 150ms, color 150ms;
  }

  .palette-trigger:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .key-plus {
    margin-left: 0.22em;
  }

  /* Only offer the shortcut button where there is a keyboard behind it. */
  :global(html.js) .palette-trigger {
    display: inline-block;
  }

  @media (hover: none) and (pointer: coarse) {
    :global(html.js) .palette-trigger {
      display: none;
    }
  }

  @media (max-width: 819px) {
    .nav-toggle {
      display: flex;
    }

    .nav-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem;
      display: none;
    }

    .nav-menu.open {
      display: flex;
    }
  }

  @media (min-width: 820px) {
    .nav-toggle {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('nav-toggle');
    var menu = document.getElementById('nav-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', function () {
      var isOpen = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        if (menu.classList.contains('open')) {
          menu.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    });
  })();
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var navLinks = document.querySelectorAll('.nav-menu a[data-section]');

    function setActive(sectionId) {
      navLinks.forEach(function (link) {
        link.classList.toggle('active', link.getAttribute('data-section') === sectionId);
      });
    }

    if (location.pathname !== '/' && location.pathname !== '/index.html') {
      if (location.pathname.startsWith('/projects/')) {
        setActive('projects');
      }
      return;
    }

    var sections = document.querySelectorAll('section[id]');
    var lastSectionId = sections.length ? sections[sections.length - 1].id : null;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      },
      { rootMargin: '-20% 0px -75% 0px' }
    );

    sections.forEach(function (section) {
      observer.observe(section);
    });

    // The trigger band above never reaches a short trailing section once the
    // page is scrolled to its max — force the last section active in that case.
    function checkAtBottom() {
      var atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      if (atBottom && lastSectionId) {
        setActive(lastSectionId);
      }
    }

    window.addEventListener('scroll', checkAtBottom, { passive: true });
    checkAtBottom();
  });
</script>
