---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resume — Henry Yu" description="Download Henry Yu's resume.">
  <section class="resume">
    <h1>Resume</h1>
    <a class="download" href="/resume.pdf" download>Download resume (PDF)</a>
    <p class="note">Role-specific versions available on request.</p>
  </section>
</BaseLayout>

<style>
  .resume {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }

  .download {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--color-accent);
    border-radius: 6px;
    color: var(--color-accent);
    font-weight: 700;
  }

  .download:hover {
    background-color: var(--color-accent);
    color: var(--color-bg);
    text-decoration: none;
  }

  .note {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }
</style>
