---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Henry Yu`} description={project.data.summary}>
  <article class="project-detail">
    <h1>{project.data.title}</h1>
    <p class="meta">
      <span class="status">{project.data.status}</span>
      <a href={project.data.github} target="_blank" rel="noopener noreferrer">View on GitHub</a>
    </p>
    <ul class="tags">
      {project.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .status {
    font-family: var(--font-mono);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background-color: var(--color-code-bg);
    color: var(--color-text-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .content :global(h2) {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
</style>
