---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Henry Yu`} description={project.data.summary}>
  <article class="project-detail">
    <p class="back"><a href="/#projects">&larr; All projects</a></p>
    <h1>{project.data.title}</h1>
    <p class="meta">
      <span class="status">{project.data.status}</span>
      <span class="dot" aria-hidden="true">&middot;</span>
      <span class="period">{project.data.period}</span>
      {project.data.github && (
        <a href={project.data.github} target="_blank" rel="noopener noreferrer">View on GitHub</a>
      )}
    </p>
    <ul class="tags">
      {project.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="content">
      <Content />
    </div>
    <p class="back back-foot"><a href="/#projects">&larr; All projects</a></p>
  </article>
</BaseLayout>

<style>
  .back {
    margin-top: 1.5rem;
    font-size: 0.85rem;
  }

  .back-foot {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .project-detail h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.6rem, 5vw, 2rem);
  }

  .period,
  .dot {
    font-family: var(--font-mono);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .status {
    font-family: var(--font-mono);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background-color: var(--color-code-bg);
    color: var(--color-text-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .content :global(h2) {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
</style>
